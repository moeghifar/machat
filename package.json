{
  "name": "machat",
  "version": "0.0.1",
  "private": true,
  "description": "Electron shell around WhatsApp Web",
  "author": "moeghifar",
  "homepage": "https://github.com/moeghifar/machat",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0",
    "solid-js": "^1.9.18",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.moeghifar.machat",
    "productName": "Machat",
    "files": [
      "dist/**",
      "electron/**",
      "inject/**",
      "prompts/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png",
      "category": "Network",
      "maintainer": "moeghifar"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    }
  }
}
