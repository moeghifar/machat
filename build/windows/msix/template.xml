<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="machat"
        Arguments=""
        InstallLocation="C:\Program Files\moeghifar\machat">
    </Installer>
    <PackageInformation
        PackageName="machat"
        PackageDisplayName="machat"
        PublisherName="CN=moeghifar"
        PublisherDisplayName="moeghifar"
        Version="0.1.0.0"
        PackageDescription="Local chat desktop app built on libgo">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.moeghifar.machat"
                Description="Local chat desktop app built on libgo"
                DisplayName="machat"
                ExecutableName="machat"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>machat</DisplayName>
            <PublisherDisplayName>moeghifar</PublisherDisplayName>
            <Description>Local chat desktop app built on libgo</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="machat.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
